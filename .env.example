# Copy this file to .env and fill in real values. .env is gitignored.

FLASK_ENV="production"
FLASK_DEBUG=0

# SQLAlchemy connection string. For SQLite, a relative sqlite:/// path is
# resolved against the Flask instance folder (./instance/).
SQLALCHEMY_DATABASE_URI="sqlite:///site.db"

# Shared secret required in the X-Access-Token header for POST /v1/upload.
UPLOAD_TOKEN="change-me"

# /ui accounts are not configured via .env — create them with:
#   flask create-user <username> <user|admin>
